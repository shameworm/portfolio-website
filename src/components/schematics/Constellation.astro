---
/** Hub and spokes. Platform names only — the mechanisms are labelled, the
 *  implementations are not described. */
interface Props {
  platforms: readonly string[];
  hub?: string;
}

const { platforms, hub = "PRODUCT" } = Astro.props;

const R = 104;
const CX = 150;
const CY = 124;
const CUT = 5;

function chamfer(x: number, y: number, w: number, h: number) {
  return [
    `${x + CUT},${y}`,
    `${x + w},${y}`,
    `${x + w},${y + h - CUT}`,
    `${x + w - CUT},${y + h}`,
    `${x},${y + h}`,
    `${x},${y + CUT}`,
  ].join(" ");
}

// Start at the top and walk clockwise.
const spokes = platforms.map((p, i) => {
  const a = (i / platforms.length) * Math.PI * 2 - Math.PI / 2;
  const x = CX + Math.cos(a) * R;
  const y = CY + Math.sin(a) * R;
  const w = Math.max(46, p.length * 6.2 + 12);
  return { name: p, x, y, points: chamfer(x - w / 2, y - 9, w, 18) };
});
---

<svg
  viewBox="0 0 300 248"
  class="w-full h-auto"
  role="img"
  aria-label={`${hub} connected to ${platforms.join(", ")}`}
>
  {
    spokes.map((s) => (
      <g>
        <line
          x1={CX}
          y1={CY}
          x2={s.x}
          y2={s.y}
          stroke="var(--color-gold-deep)"
          stroke-width="1"
          opacity="0.65"
        />
        <polygon
          points={s.points}
          fill="var(--color-void)"
          stroke="var(--color-panel-edge)"
          stroke-width="1"
        />
        <text
          x={s.x}
          y={s.y + 3.5}
          text-anchor="middle"
          font-family="var(--font-mono)"
          font-size="8.5"
          letter-spacing="0.08em"
          fill="var(--color-ink-dim)"
        >
          {s.name}
        </text>
      </g>
    ))
  }

  <polygon
    points={chamfer(CX - 42, CY - 14, 84, 28)}
    fill="var(--color-panel)"
    stroke="var(--color-gold)"
    stroke-width="1"
  />
  <text
    x={CX}
    y={CY + 4}
    text-anchor="middle"
    font-family="var(--font-mono)"
    font-size="10"
    letter-spacing="0.12em"
    fill="var(--color-gold)">{hub}</text
  >
</svg>
