---
import Base from "@/layouts/Base.astro";
import Panel from "@/components/primitives/Panel.astro";
import Label from "@/components/primitives/Label.astro";
import Rule from "@/components/primitives/Rule.astro";
import Constellation from "@/components/schematics/Constellation.astro";
import DeltaBars from "@/components/schematics/DeltaBars.astro";
import { profile, proofMarkers } from "@/content/profile";
import { work, fieldNotes } from "@/content/work";
import { capabilities } from "@/content/capabilities";
import { roles, education } from "@/content/timeline";


const elsewhere = [
  { href: profile.github, label: "GitHub" },
  { href: profile.linkedin, label: "LinkedIn" },
  { href: profile.cv, label: "Curriculum vitae" },
];
---

<Base title={`${profile.name} — Full-stack engineer`} description={profile.positioning}>
  <a href="#work" class="skip">Skip to selected work</a>

  <main class="page-light grain">
    {/* ── Identity ──────────────────────────────────────────── */}
    <header class="px-6 pt-20 pb-16 sm:pt-28 sm:pb-20">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-[62ch]">
          <h1
            class="font-display uppercase leading-[0.9] tracking-[-0.025em]"
            style="font-size: clamp(2.75rem,8vw,5.75rem); font-stretch: 78%; font-weight: 600"
          >
            Dmytro<br />Omelchenko
          </h1>

          <p
            class="enter font-prose text-[clamp(1.25rem,2.6vw,1.75rem)] leading-[1.5] mt-10 max-w-[34ch] text-ink"
            style="--enter-delay: 90ms"
          >
            {profile.positioning}
          </p>

          <p
            class="enter font-prose text-[15px] leading-[1.75] mt-6 max-w-[58ch] text-ink-dim"
            style="--enter-delay: 160ms"
          >
            {profile.intro}
          </p>

          <ul class="enter mt-14 grid grid-cols-3 gap-x-8 gap-y-5 max-w-xl list-none p-0" style="--enter-delay: 230ms">
            {
              proofMarkers.map((m) => (
                <li>
                  <p
                    class="font-display text-gold text-[clamp(1.7rem,4vw,2.4rem)] tabular-nums leading-none"
                    style="font-stretch: 84%; font-weight: 500"
                  >
                    {m.value}
                  </p>
                  <p class="micro mt-3 leading-[1.6] max-w-[18ch]">{m.label}</p>
                </li>
              ))
            }
          </ul>

          <p class="enter micro mt-12 flex flex-wrap items-center gap-3" style="--enter-delay: 290ms">
            <span aria-hidden="true" class="inline-block w-[7px] h-[7px] rounded-full bg-gold"></span>
            {profile.availability}
            <span class="text-panel-edge" aria-hidden="true">|</span>
            {profile.location}, {profile.timezone}
          </p>

          <div class="enter mt-7 flex flex-wrap items-center gap-x-7 gap-y-3" style="--enter-delay: 350ms">
            <a href={`mailto:${profile.email}`} class="edge-grow font-mono text-[12px] tracking-[0.1em] text-gold">
              {profile.email}
            </a>
            <a href={profile.cv} class="edge-grow font-mono text-[12px] tracking-[0.1em] text-ink-dim">
              Download CV
            </a>
          </div>

        </div>

      </div>
    </header>

    {/* ── Selected work ─────────────────────────────────────── */}
    <section id="work" class="px-6 py-16 scroll-mt-8">
      <div class="mx-auto max-w-6xl">
        <Rule class="mb-6" />
        <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 mb-12">
          <h2 class="font-display text-[clamp(1.6rem,3.4vw,2.4rem)] leading-tight" style="font-stretch: 86%; font-weight: 500">
            Selected work
          </h2>
          <Label class="normal-case tracking-[0.1em]">Three cases</Label>
        </div>
        <div class="grid gap-6 lg:grid-cols-3">
          {
            work.map((w) => (
              <Panel class="h-full">
                <a href={`/work/${w.slug}`} class="flex h-full flex-col p-6 sm:p-7">
                  <Label class="text-gold">{w.domain}</Label>
                  <h3 class="font-display text-[1.4rem] leading-[1.2] mt-4" style="font-stretch: 88%; font-weight: 500">
                    {w.title}
                  </h3>
                  <p class="font-prose text-[14.5px] leading-[1.7] text-ink-dim mt-4 grow">{w.thesis}</p>
                  <div class="mt-7">
                    <Rule class="mb-4" />
                    <p class="micro">{w.stack.join("  ·  ")}</p>
                    <p class="font-mono text-[12px] text-ink mt-3">{w.marker}</p>
                  </div>
                </a>
              </Panel>
            ))
          }
        </div>
      </div>
    </section>

    {/* ── Capabilities ──────────────────────────────────────── */}
    <section class="px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <Rule class="mb-6" />
        <h2 class="font-display text-[clamp(1.6rem,3.4vw,2.4rem)] leading-tight mb-12" style="font-stretch: 86%; font-weight: 500">
          Capabilities
        </h2>
        <dl class="list-none p-0 m-0">
          {
            capabilities.map((c) => (
              <div class="grid gap-x-10 gap-y-3 py-6 border-b border-[#221d14] last:border-0 sm:grid-cols-12">
                <dt class="sm:col-span-3 font-mono text-[12px] tracking-[0.12em] text-gold">{c.group}</dt>
                <dd class="sm:col-span-9 m-0 flex flex-wrap gap-x-7 gap-y-2.5">
                  {c.items.map((item) => <span class="font-display text-[15px] text-ink-dim">{item}</span>)}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {/* ── Field notes ───────────────────────────────────────── */}
    <section class="bleed px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <Rule class="mb-6" />
        <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 mb-12">
          <h2 class="font-display text-[clamp(1.6rem,3.4vw,2.4rem)] leading-tight" style="font-stretch: 86%; font-weight: 500">
            Field notes
          </h2>
          <Label class="normal-case tracking-[0.1em]">Evidence without a case page</Label>
        </div>
        <div class="grid gap-6 lg:grid-cols-2">
          <Panel>
            <div class="p-7 sm:p-8">
              <p class="font-display text-gold text-[clamp(2.4rem,6vw,3.5rem)] leading-none tabular-nums" style="font-stretch: 84%; font-weight: 500">
                {fieldNotes.performance.headline}
              </p>
              <h3 class="font-display text-[1.2rem] mt-4" style="font-stretch: 88%; font-weight: 500">
                {fieldNotes.performance.title}
              </h3>
              <Rule class="my-6" />
              <ul class="list-none p-0 space-y-2.5">
                {fieldNotes.performance.method.map((m) => (
                  <li class="font-prose text-[14.5px] leading-[1.6] text-ink-dim">{m}</li>
                ))}
              </ul>
              <div class="mt-8">
                <DeltaBars before={100} after={50} beforeLabel="First load, before" afterLabel="First load, after" />
              </div>
            </div>
          </Panel>

          <Panel>
            <div class="p-7 sm:p-8">
              <p class="font-display text-gold text-[clamp(2.4rem,6vw,3.5rem)] leading-none tabular-nums" style="font-stretch: 84%; font-weight: 500">
                {fieldNotes.integrations.headline}
              </p>
              <h3 class="font-display text-[1.2rem] mt-4" style="font-stretch: 88%; font-weight: 500">
                {fieldNotes.integrations.title}
              </h3>
              <Rule class="my-6" />
              <div class="mt-2 max-w-[360px] mx-auto">
                <Constellation platforms={fieldNotes.integrations.platforms} />
              </div>
              <p class="micro mt-7 leading-[1.6]">{fieldNotes.integrations.mechanisms.join("  ·  ")}</p>
            </div>
          </Panel>
        </div>
      </div>
    </section>

    {/* ── Experience ────────────────────────────────────────── */}
    <section class="px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <Rule class="mb-6" />
        <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 mb-12">
          <h2 class="font-display text-[clamp(1.6rem,3.4vw,2.4rem)] leading-tight" style="font-stretch: 86%; font-weight: 500">
            Experience
          </h2>
          <Label class="normal-case tracking-[0.1em]">Two years, three teams</Label>
        </div>
        <ol class="list-none p-0">
          {
            roles.map((r) => (
              <li class="grid gap-x-10 gap-y-4 py-7 border-b border-[#221d14] last:border-0 sm:grid-cols-12">
                <div class="sm:col-span-3">
                  <p class="font-mono text-[12px] tracking-[0.1em] text-ink-dim">{r.period}</p>
                  {r.note && <p class="micro mt-2 text-gold">{r.note}</p>}
                </div>
                <div class="sm:col-span-9 flex gap-5">
                  <span class="chamfer-cell w-9 h-9 shrink-0 bg-panel grid place-items-center">
                    <img
                      src={r.logo}
                      width="36"
                      height="36"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="mark w-9 h-9"
                    />
                  </span>
                  <div>
                    <h3 class="font-display text-[1.15rem] flex items-center gap-3" style="font-stretch: 88%; font-weight: 500">
                      {r.title}, {r.company}
                      {r.current && (
                        <>
                          <span class="sr-only">Current role</span>
                          <span aria-hidden="true" class="inline-block w-[6px] h-[6px] rounded-full bg-gold" />
                        </>
                      )}
                    </h3>
                    <p class="font-prose text-[14.5px] leading-[1.7] text-ink-dim mt-2 max-w-[70ch]">{r.summary}</p>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ── Education ─────────────────────────────────────────── */}
    <section class="px-6 py-16">
      <div class="mx-auto max-w-6xl">
        <Rule class="mb-6" />
        <h2 class="font-display text-[clamp(1.6rem,3.4vw,2.4rem)] leading-tight mb-12" style="font-stretch: 86%; font-weight: 500">
          Education
        </h2>
        <ol class="list-none p-0">
          {
            education.map((e) => (
              <li class="grid gap-x-10 gap-y-3 py-7 border-b border-[#221d14] last:border-0 sm:grid-cols-12">
                <div class="sm:col-span-3">
                  <p class="font-mono text-[12px] tracking-[0.1em] text-ink-dim">{e.period}</p>
                </div>
                <div class="sm:col-span-9">
                  <h3 class="font-display text-[1.15rem]" style="font-stretch: 88%; font-weight: 500">{e.degree}</h3>
                  <p class="font-prose text-[14.5px] leading-[1.7] text-ink-dim mt-2">{e.school}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ── Terminus ──────────────────────────────────────────── */}
    <footer class="px-6 pt-20 pb-16">
      <div class="mx-auto max-w-6xl">
        <Rule class="mb-10" />
        <div class="grid gap-10 sm:grid-cols-12">
          <div class="sm:col-span-7">
            <p class="font-display text-[clamp(1.5rem,3vw,2rem)] leading-tight max-w-[22ch]" style="font-stretch: 86%; font-weight: 500">
              Hiring, or building something that needs to work?
            </p>
            <a href={`mailto:${profile.email}`} class="edge-grow inline-block font-mono text-[13px] tracking-[0.08em] text-gold mt-6">
              {profile.email}
            </a>
          </div>
          <nav class="sm:col-span-5 sm:justify-self-end" aria-label="Elsewhere">
            <ul class="list-none p-0 space-y-3">
              {
                elsewhere.map((l) => (
                  <li>
                    <a href={l.href} class="edge-grow font-mono text-[13px] tracking-[0.08em] text-ink-dim">
                      {l.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </footer>
  </main>
</Base>
